# ============================================================
#               Hermes Portable — .gitignore
# ============================================================

# --- Изолированные данные (создаются скриптами) ---
data/
repo/
models/
python-*/
python/
output/
logs/
*.log

# --- Генерируемые файлы ---
*.wav
*.mp3
*.safetensors
*.bin
*.ckpt
*.pth

# --- Windows ---
*.exe
*.dll
*.zip
*.7z

# --- Исключения: портабельные бинарники в репозитории ---
!scripts/bin/uv.exe

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- IDE ---
.vs/
.vscode/
.idea/
*.sln
*.pyproj
*.user

# --- Пользовательские настройки (генерируются автоматом) ---
scripts/Config.ini
.env

# --- Случайные папки кэша (если есть)
Microsoft/
pip/

# --- Репозитории
node-dist/
uv/
/scripts/en-locale/en.ts
/kobold/1000
/scripts/zh-locale/zh.ts
/scripts/ru-locale/ru.ts.bak
/kobold/start.bat
/kobold/default.kcpps
/error
/password
/Projects/Знакомство/IDEA.md
/Projects/API-vb4.8
/gpu-monitor
/Temp
/nul
/query
/Запуск Hermes.lnk
*.bak_vk

# генерируемые бэкапы и промежуточные файлы русификации
scripts/en-locale/*.bak
scripts/ru-locale/*.bak
scripts/ru-locale/*.pre-mirror
scripts/ru-locale/*.pre-sort
skills-repo/
data/temp/
*.log

# Бэкапы базы разговоров — тяжёлые дампы, хранятся на диске, не в git
durable/ЛЕТОПИСЬ/state-*.db
durable/ЛЕТОПИСЬ/*.db
# креды и тяжёлые бэкапы баз живут только локально, в репу не идут
durable/creds.env
durable/memory/backup-memories/creds.env
durable/**/*.db.bak*
durable/memory/*.db
durable/memory/*.db.bak*
